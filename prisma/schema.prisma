generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  location      String?
  bio           String?   @db.Text
  profession    String?
  
  // Phase 1 Profile Fields
  linkedInId    String?
  isVeteran     Boolean   @default(false)
  skillsInventory Json?   // JSONB
  isAfrican     Boolean   @default(false)
  
  // Phase 2 Matching Fields
  targetLocation String?
  isInvestor    Boolean   @default(false)
  investmentRange String?
  willingnessToTeach Boolean @default(false)
  onboarded     Boolean   @default(false)
  
  // Trust & Safety Fields
  isVerified     Boolean @default(false)
  stealthMode    Boolean @default(false)
  locationPrivacy String @default("EXACT") // EXACT, CITY, COUNTRY, HIDDEN
  
  // Taxonomy Fields
  sector        EconomicSector?
  subSectors    String[]      // Sub-sectors for specific taxonomy icons
  sicCode       String?
  titles        String[]      // Standardized titles from Job Library
  residenceStatus String?     @default("UNKNOWN") // "DIASPORA", "CONTINENTAL", "UNKNOWN"

  accounts      Account[]
  sessions      Session[]
  coopertunities Coopertunity[]
  subscriptions Subscription[]
  matches       Match[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Phase 4 Relations
  searchHistory SearchHistory[]
  interactions  Interaction[]
  
  // Phase 5 Relations
  isPrivate     Boolean       @default(false)
  sentRequests  ConnectionRequest[] @relation("Sender")
  receivedRequests ConnectionRequest[] @relation("Receiver")
  conversations Conversation[] @relation("UserConversations")
  messages      Message[]
  reports       Report[]

  // Phase 8 Profile Enrichment
  workHistory   WorkExperience[]
  education     Education[]

  // Phase 9: Network Stakeholders & Watchlists
  ownedStakeholders   Stakeholder[]       @relation("StakeholderOwner")
  stakeholderMemberships Stakeholder[]    @relation("StakeholderMembers")
  watchlists    Watchlist[]

  // Phase 10: Notification Center
  notifications Notification[]
  
  // Phase 10: Data Ingestion (OAuth Drafts)
  draft         UserDraft?
}

model UserDraft {
    id          String   @id @default(cuid())
    userId      String   @unique
    firstName   String?
    lastName    String?
    email       String?
    location    String?
    avatarUrl   String?
    headline    String?
    positions   Json?    // Store raw LinkedIn positions array temporarily
    
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model WorkExperience {
    id          String   @id @default(cuid())
    userId      String
    title       String
    company     String
    location    String?
    startDate   DateTime
    endDate     DateTime?
    current     Boolean  @default(false)
    description String?  @db.Text
    
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model Education {
    id           String   @id @default(cuid())
    userId       String
    school       String
    degree       String?
    fieldOfStudy String?
    startDate    DateTime?
    endDate      DateTime?
    
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
}

model ConnectionRequest {
  id        String   @id @default(cuid())
  senderId  String
  receiverId String
  status    String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  
  // Phase 5: Network Expansion
  type           String?  // "PERSONAL", "BUSINESS"
  coopertunityId String?  // Optional context
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sender    User     @relation("Sender", fields: [senderId], references: [id])
  receiver  User     @relation("Receiver", fields: [receiverId], references: [id])
  
  @@unique([senderId, receiverId])
}

model Stakeholder {
  id        String   @id @default(cuid())
  ownerId   String
  name      String   // e.g. "Accra Solar Team"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User     @relation("StakeholderOwner", fields: [ownerId], references: [id])
  members   User[]   @relation("StakeholderMembers")
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  title     String
  sector    String?
  keywords  String[]
  lastChecked DateTime @default(now())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  participants User[] @relation("UserConversations")
  messages     Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachmentUrl  String?
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
}

model Report {
  id        String   @id @default(cuid())
  reporterId String
  targetId   String   // User ID or Post ID
  targetType String   // "USER", "COOPERTUNITY", "MESSAGE"
  reason     String
  status     String   @default("PENDING") // PENDING, REVIEWED, RESOLVED
  createdAt  DateTime @default(now())
  
  reporter   User     @relation(fields: [reporterId], references: [id])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  targetUserId String?
  targetSector EconomicSector?
  
  createdAt DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Coopertunity {
  id                String         @id @default(cuid())
  title             String
  description       String
  type              CoopertunityType
  sector            EconomicSector
  subSector         String?
  sicCode           String?
  requiredSkills    String[]
  
  // Phase 3 Fields
  location          String?
  latitude          Float?
  longitude         Float?
  
  investmentAmount  Float?
  amountRaised      Float          @default(0) // For Non-Profits/Donations
  investorsCount    Int            @default(0) // For Investments Tracker
  compensationType  String?       // "PAID", "EQUITY", "VOLUNTEER", "INVESTMENT"
  
  isNonProfit       Boolean        @default(false)
  isAvailable       Boolean        @default(true) // New field for availability
  willingnessToTeach Boolean       @default(false) // Added for skill sharing
  donationLink      String?
  
  keywords          String[]
  stakeholders      Json?          // Array of roles needed
  
  landTitleVerified Boolean        @default(false)

  authorId          String
  author            User           @relation(fields: [authorId], references: [id])
  status            String         @default("OPEN")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  expiresAt         DateTime?
  matches           Match[]
}

model Match {
  id             String       @id @default(cuid())
  userId         String
  coopertunityId String
  score          Float        // Utility Score (0.0 - 1.0)
  status         String       @default("PENDING") // PENDING, VIEWED, ACCEPTED, REJECTED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coopertunity   Coopertunity @relation(fields: [coopertunityId], references: [id], onDelete: Cascade)

  @@unique([userId, coopertunityId])
  @@index([userId])
  @@index([coopertunityId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Interaction {
  id             String        @id @default(cuid())
  actorId        String
  targetId       String        // Can be User ID or Coopertunity ID
  targetType     String        // "USER", "COOPERTUNITY"
  action         String        // "PASS", "WATCH", "CONNECT"
  createdAt      DateTime      @default(now())
  
  actor          User          @relation(fields: [actorId], references: [id])
}

model JobListing {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String
  description String
  url         String
  source      String   // "Indeed", "Google"
  postedAt    DateTime
  createdAt   DateTime @default(now())
}

enum CoopertunityType {
  PROJECT       // Team/Squad
  ROLE          // Single Job
  DEAL          // Investment
  LAND_DEAL     // Land specific
}

enum EconomicSector {
  PRIMARY
  SECONDARY
  TERTIARY
  QUATERNARY
}

// -----------------------------------------------------------------------------
// PHASE 10: NOTIFICATION CENTER
// -----------------------------------------------------------------------------

enum NotificationTier {
  TIER_1 // High Alert - Economic Matches (The Opportunity Bell)
  TIER_2 // Standard - Connections, Messages (The Chat Bubble)
  TIER_3 // Low - Newsletters, System Updates
}

enum NotificationType {
  MATCH         // Direct Coopertunity match based on skills/location
  CONNECTION    // Connection Request / Accept
  MESSAGE       // Direct Message 
  SYSTEM        // Platform News
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           // The recipient
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  tier        NotificationTier @default(TIER_2)
  type        NotificationType
  
  title       String
  message     String           @db.Text
  
  isRead      Boolean          @default(false)
  linkUrl     String?          // E.g., /coopertunities/[id] or /network
  
  // Optional relations context
  relatedId   String?          // e.g. coopertunity id, or sender user id
  
  createdAt   DateTime         @default(now())
}
